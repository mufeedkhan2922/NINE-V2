{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "lib/trading/types.ts",
    "lib/trading/technical.ts",
    "lib/trading/smc.ts",
    "lib/trading/risk.ts",
    "lib/trading/backtest.ts",
    "tests/**/*.test.ts",
    "tests/assert.ts",
    "tests/testRunner.ts",
    "tests/testBootstrap.ts",
    "lib/trading/runtime.ts",
    "lib/trading/provider.ts",
    "lib/security/rateLimit.ts",
    "lib/security/requestSecurity.ts",
    "tests/runtime.test.ts",
    "tests/security.test.ts",
    "lib/trading/*.ts",
    "lib/security/*.ts"
  ]
}
